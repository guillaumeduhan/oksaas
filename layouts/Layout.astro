---
import "../globals.css";
import Header from "../src/components/Header.astro";
import Footer from "../src/components/Footer.astro";
import { SITE } from "../src/lib/items";

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, e.g. "/page/2" — used for canonical and og:url. */
  path?: string;
  ogType?: "website" | "article";
  /** Extra JSON-LD objects for this page. */
  jsonLd?: object[];
}

const {
  title = "OkSaaS — The Best SaaS Drop, Every Week.",
  description = "OkSaaS curates the best new SaaS products every week. Discover trending tools before everyone else and submit your SaaS for free.",
  path = "/",
  ogType = "website",
  jsonLd = [],
} = Astro.props;
const url = `${SITE}${path}`;
const image = `${SITE}/og-image.png`; // 1200x630
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- Canonical -->
    <link rel="canonical" href={url} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="en" href={url} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="OkSaaS" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:creator" content="@oksaas" />

    <!-- JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "OkSaaS",
        url: `${SITE}/`,
        description: "The best SaaS drop, every week.",
        publisher: { "@type": "Organization", name: "OkSaaS", logo: { "@type": "ImageObject", url: `${SITE}/logo.png` } },
        sameAs: ["https://x.com/oksaas"],
      })}
    />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...ld })} />)}

    <!-- Theme -->
    <meta name="theme-color" content="#0a0a0a" />

    <script defer data-domain="oksaas.co" src="https://analytics.guillaume.ceo/js/tracker.js"></script>

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-NZVRr75V_CLz7MtN6izt5.js"
    ></script>
    <script>
      ((window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        }),
        (plausible.init =
          plausible.init ||
          function (i) {
            plausible.o = i || {};
          }));
      plausible.init();
    </script>
  </head>

  <body>
    <main class="mx-auto flex max-w-[880px] flex-col gap-14 px-6 pt-14 pb-20">
      <Header />
      <slot />
      <Footer />
    </main>
  </body>
</html>
