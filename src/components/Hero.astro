---
interface Props {
  title?: string;
}

const { title = "The best SaaS drop, every week." } = Astro.props;
---

<section class="flex flex-col gap-3">
  <p class="text-muted">$ cat about.txt</p>
  <h1 class="text-3xl leading-10 font-bold text-white">
    {title}<span class="cursor-blink text-accent" aria-hidden="true">█</span>
  </h1>
  <p class="text-subtle">22,944 visitors last week. Free launch, free backlink.</p>
  <slot />
</section>
