---
import { featured, label, outboundHref, outboundRel } from "../lib/items";
---

<section aria-labelledby="t-feat" class="flex flex-col gap-1">
  <h2 id="t-feat" class="mb-2 text-base font-normal text-muted">$ ls ./featured</h2>
  {
    featured.map((f) => (
      <a
        href={outboundHref(f)}
        target="_blank"
        rel={outboundRel(f)}
        class:list={[
          "group flex items-center gap-4 px-3 py-2 no-underline",
          f.is_promoted
            ? "bg-sponsored-bg text-sponsored hover:bg-sponsored-bg-hover hover:text-sponsored"
            : "bg-accent-bg text-accent hover:bg-accent-bg-hover hover:text-accent",
        ]}
      >
        <span class="min-w-0 flex-auto truncate">
          <span>{f.title}</span> <span class="text-muted">— {label(f)}</span>
        </span>
        <span class="flex-none">{f.is_promoted ? "sponsored" : "featured"}</span>
        <span class="flex-none">↗</span>
      </a>
    ))
  }
</section>
