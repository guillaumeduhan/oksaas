---
interface Item {
  icon: string;
  title: string;
  description?: string;
  url: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section>
  <ul class="grid gap-1">
    {
      items.map((a) => (
        <li class="group text-[16px] text-neutral-400 py-[3px] px-3 cursor-pointer">
          <a
            href={a.url}
            class="flex gap-2 items-center justify-between text-[16px] text-neutral-400 py-[3px] px-2 cursor-pointer hover:bg-neutral-800 transition duration-300"
            target="_blank"
          >
            <div class="flex items-center gap-2">
              <span set:html={a.icon} class="size-8" />
              <span>{a.title}</span>
            </div>
            {a.description && (
              <span class="text-neutral-700 group-hover:text-white transition duration-300">
                {a.description}
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</section>
