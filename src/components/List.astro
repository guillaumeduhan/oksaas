---
import { PAGE_SIZE, domain, itemHref, outboundHref, outboundRel, pageHref, timeAgo, type Item } from "../lib/items";

interface Props {
  items: Item[];
  page: number;
  pageCount: number;
  heading?: string;
}

const { items, page, pageCount, heading = page === 1 ? "LATEST" : `LATEST · PAGE ${page}` } = Astro.props;
const offset = (page - 1) * PAGE_SIZE;
const num = (i: number) => String(offset + i + 1).padStart(2, "0");
---

<section aria-labelledby="i-latest" class="flex flex-col gap-4">
  <h2 id="i-latest" class="text-sm font-normal text-muted">{heading}</h2>
  <div class="border-t border-line">
    {
      items.map((p, i) => (
        <div class="group relative flex items-baseline gap-6 border-b border-line py-3.5 text-soft">
          <span class="w-8 flex-none text-sm text-faint">{num(i)}</span>
          <span class="min-w-0 flex-auto truncate">
            <a
              href={itemHref(p)}
              class="font-display text-2xl leading-[30px] font-medium text-soft no-underline group-hover:text-accent after:absolute after:inset-0"
            >
              {p.title}
            </a>
            <span class="text-sm text-dim">&#160;— {domain(p.url)}</span>
          </span>
          <span class="flex-none text-sm text-dim">{timeAgo(p.created_at)}</span>
          <a
            href={outboundHref(p)}
            target="_blank"
            rel={outboundRel(p)}
            aria-label={`Visit ${p.title}`}
            class="relative z-10 flex-none text-faint no-underline transition-transform duration-[120ms] hover:translate-x-0.5 hover:-translate-y-0.5 hover:text-accent"
          >
            ↗
          </a>
        </div>
      ))
    }
  </div>
  <nav class="flex gap-6 text-sm">
    {page > 1 && <a href={pageHref(page - 1)} class="no-underline">← Newer</a>}
    {page < pageCount && <a href={pageHref(page + 1)} class="no-underline">Previous →</a>}
  </nav>
</section>
